        }
      ]
    },
    {
      "slide_id": 10,
      "title": "Solution – Probabilité totale",
      "coverage": 0.778,
      "flagged": true,
      "novel_word_ratio": 0.753,
      "items": [
        {
          "kind": "bullet",
          "text": "P(urne choisie) = 1/2 pour chaque urne",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "P(R|U1) = 3/5, P(R|U2) = 1/5",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "P(R) = 1/2·3/5 + 1/2·1/5 = 2/5",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "Probabilité totale : somme des produits probabilité d'urne et probabilité rouge conditionnée.",
          "score": 0.714,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "Résultat final de la probabilité d'obtenir une boule rouge.",
          "score": 0.667,
          "covered": true
        },
        {
          "kind": "talking_point",
          "text": "Chaque urne étant équi‑probable, on multiplie la probabilité de choisir l'urne par la probabilité d'une rouge dans celle‑ci.",
          "score": 0.6,
          "covered": true
        },
        {
          "kind": "talking_point",
          "text": "On calcule d'abord les proportions : 3/5 dans U1, 1/5 dans U2.",
          "score": 0.333,
          "covered": false
        },
        {
          "kind": "talking_point",
          "text": "On applique la formule des probabilités totales et on simplifie les fractions.",
          "score": 0.5,
          "covered": false
        },
        {
          "kind": "talking_point",
          "text": "Vérifier : la somme des contributions donne bien 2/5, soit 0,4.",
          "score": 1.0,
          "covered": true
        }
      ]
    }
