    {
      "slide_id": 2,
      "title": "Random Experiments and Sample Spaces",
      "coverage": 1.0,
      "flagged": false,
      "novel_word_ratio": 0.56,
      "items": [
        {
          "kind": "bullet",
          "text": "Random experiment: outcome cannot be predicted with certainty (e.g. coin toss, bulb lifetime)",
          "score": 0.8,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Sample space S: set of all possible outcomes",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "One die roll: S = {1, 2, 3, 4, 5, 6}",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Event: a subset of the sample space, e.g. \"roll is even\" A = {2, 4, 6}",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "An event occurs when the outcome belongs to it; empty set is impossible, S is certain",
          "score": 1.0,
          "covered": true
        }
      ]
    },
    {
      "slide_id": 3,
      "title": "Combining Events",
      "coverage": 1.0,
      "flagged": false,
      "novel_word_ratio": 0.588,
      "items": [
        {
          "kind": "bullet",
          "text": "Union of A and B: A or B occurs",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Intersection of A and B: both occur",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Complement of A: A does not occur",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Mutually exclusive (disjoint): cannot occur together, intersection is empty",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Example: A = even, B = greater than 3; union {2, 4, 5, 6}, intersection {4, 6}",
          "score": 0.8,
          "covered": true
        }
      ]
    },
    {
      "slide_id": 4,
      "title": "Kolmogorov's Axioms",
      "coverage": 1.0,
      "flagged": false,
      "novel_word_ratio": 0.562,
      "items": [
        {
          "kind": "bullet",
          "text": "A probability measure assigns a number P(A) to every event A",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Probabilities are never negative",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "The probability of the whole sample space is one",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Probability of a union of mutually exclusive events is the sum of their probabilities",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "Every event has non-negative probability, and the certain event has probability one.",
          "score": 0.8,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "For disjoint events, the probability that one or the other occurs is the sum of their probabilities.",
          "score": 1.0,
          "covered": true
        }
      ]
    },
    {
      "slide_id": 5,
      "title": "Consequences of the Axioms",
      "coverage": 1.0,
      "flagged": false,
      "novel_word_ratio": 0.51,
      "items": [
        {
          "kind": "bullet",
          "text": "Complement of A has probability one minus P(A)",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "The impossible event has probability zero",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Addition rule for any two events subtracts the intersection, which would be counted twice",
          "score": 0.714,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Equally likely outcomes: P(event) = outcomes in event / total outcomes",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Fair die: P(even) = 3/6 = 1/2",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "General addition rule: add the probabilities and remove the double-counted overlap.",
          "score": 1.0,
          "covered": true
        }
      ]
    },
    {
      "slide_id": 6,
      "title": "Conditional Probability",
      "coverage": 1.0,
      "flagged": false,
      "novel_word_ratio": 0.585,
      "items": [
        {
          "kind": "bullet",
          "text": "Describes how probability of an event changes when another event is known to have occurred",
          "score": 0.857,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "P(A given B) is defined when P(B) is greater than zero",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Multiplication rule: P(A and B) = P(A given B) times P(B)",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "The probability of A given B is the probability of both occurring divided by the probability of B.",
          "score": 0.8,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "Multiplication rule, obtained by rearranging the definition of conditional probability.",
          "score": 0.714,
          "covered": true
        }
      ]
    },
    {
      "slide_id": 7,
      "title": "Total Probability and Independence",
      "coverage": 0.667,
      "flagged": true,
      "novel_word_ratio": 0.429,
      "items": [
        {
          "kind": "bullet",
          "text": "Law of total probability splits P(A) over a partition into disjoint cases B1, ..., Bn",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Independent: knowing one occurred does not change the probability of the other",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Equivalently, P of the intersection is the product of the probabilities",
          "score": 0.5,
          "covered": false
        },
        {
          "kind": "bullet",
          "text": "Independence is not mutual exclusivity: disjoint events with positive probabilities are always dependent",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "The probability of A is a weighted sum of its conditional probabilities over all cases of a partition.",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "Condition for A and B to be independent.",
          "score": 0.5,
          "covered": false
        }
      ]
    },
    {
      "slide_id": 8,
      "title": "Worked Example: Two Aces",
      "coverage": 1.0,
      "flagged": false,
      "novel_word_ratio": 0.59,
      "items": [
        {
          "kind": "bullet",
          "text": "Draw two cards from a deck without replacement",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "P(both aces) = 4/52 times 3/51, about 0.0045",
          "score": 0.75,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "The second factor is a conditional probability: the first ace has been removed",
          "score": 1.0,
          "covered": true
        }
      ]
    },
    {
      "slide_id": 9,
      "title": "Bayes' Theorem",
      "coverage": 1.0,
      "flagged": false,
      "novel_word_ratio": 0.475,
      "items": [
        {
          "kind": "bullet",
          "text": "Reverses a conditional probability",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Expresses P(B given A) using P(A given B), which is often easier to know",
          "score": 0.833,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "P(B) is the prior probability; P(B given A) is the posterior probability",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Denominator P(A) is usually computed with the law of total probability",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "The posterior probability of B given A equals the likelihood of A given B times the prior of B, divided by P(A).",
          "score": 1.0,
          "covered": true
        }
      ]
    },
    {
      "slide_id": 10,
      "title": "Worked Example: Medical Test",
      "coverage": 1.0,
      "flagged": false,
      "novel_word_ratio": 0.681,
      "items": [
        {
          "kind": "bullet",
          "text": "Disease affects 1% of the population",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Test detects 99% of sick people; 5% false positives among healthy people",
          "score": 0.875,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "P(sick given positive) = 0.99·0.01 / (0.99·0.01 + 0.05·0.99), about 0.17",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "The prior is so small that most positive results are false positives",
          "score": 1.0,
          "covered": true
        }
      ]
    },
    {
      "slide_id": 11,
      "title": "Random Variables, Mean and Variance",
      "coverage": 1.0,
      "flagged": false,
      "novel_word_ratio": 0.39,
      "items": [
        {
          "kind": "bullet",
          "text": "Random variable: function assigning a number to each outcome",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Discrete: takes a finite or countable number of values",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "PMF p(x): probability the variable equals x; non-negative and sums to one",
          "score": 0.714,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Expectation: probability-weighted average; variance: spread around the mean",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "The mean is the sum of each value weighted by its probability.",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "The variance is the mean of the square minus the square of the mean.",
          "score": 1.0,
          "covered": true
        }
      ]
    },
    {
      "slide_id": 12,
      "title": "Linearity and Fair Die Example",
      "coverage": 1.0,
      "flagged": false,
      "novel_word_ratio": 0.477,
      "items": [
        {
          "kind": "bullet",
          "text": "Expectation is linear: E[aX + b] = a E[X] + b for any constants a, b",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Var(aX + b) = a squared times Var(X): adding a constant does not change the spread",
          "score": 0.857,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "Fair die: E[X] = (1 + 2 + ... + 6) / 6 = 3.5",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "bullet",
          "text": "E[X squared] = 91/6, so variance = 91/6 - 12.25, about 2.92",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "Scaling and shifting a random variable scales and shifts its mean in the same way.",
          "score": 1.0,
          "covered": true
        },
        {
          "kind": "equation",
          "text": "Scaling multiplies the variance by the square of the factor; shifting has no effect.",
          "score": 0.857,
          "covered": true
        }
      ]
    }
  ]
}